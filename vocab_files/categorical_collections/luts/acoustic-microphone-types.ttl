    urnp:conceptDefinition "Directional acoustic microphones are designed to focus on sounds from a particular direction while attenuating off-axis noise in the audible frequency range." ;
    urnp:conceptNotation "DA" ;
    urnp:conceptSource "https://core.vocabs.paratoo.tern.org.au/api/lut-acoustic-microphone-types"^^xsd:anyURI ;
.

