    urnp:conceptDefinition "Omnidirectional ultrasonic microphones capture sound equally from all directions and are designed to detect ultrasonic frequencies beyond human hearing." ;
    urnp:conceptNotation "OU" ;
    urnp:conceptSource "https://core.vocabs.paratoo.tern.org.au/api/lut-acoustic-microphone-types"^^xsd:anyURI ;
.

<https://linked.data.gov.au/def/nrm/1d7b4714-80b8-4ba2-b12b-8f30e6a44ea6>
    a urnc:CategoricalConceptMeta ;
